<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" href="{{ asset('/img/logo.svg') }}" />
		<title>
			{% block title %}{% endblock %}
		</title>
		{{ encore_entry_link_tags('app') }}
		{# <link rel="stylesheet" href="{{ asset('css/style.css') }}">
		<link rel="stylesheet" href="{{ asset('css/hero.css') }}">
		<link rel="stylesheet" href="{{ asset('css/values_propositions.css') }}">
		<link rel="stylesheet" href="{{ asset('css/footer.css') }}">
		<link rel="stylesheet" href="{{ asset('css/side_bar.css') }}">  #}
		{% block stylesheets %}{% endblock %}
		{% block javascripts %}
    		{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body class="bg-lighgray loading">

		<header>
			{% include "components/_user_nav.html.twig" %}
		</header>

		<main class="main-content">
			<div class="container-fluid">
				<h1>
					{% block h1 %}{% endblock %}
				</h1>
				{% block body %}{% endblock %}
			</div>
		</main>

		{% if not app.user %}
			{% include "_home_footer.html.twig" %}
		{% endif %}



	</body>
</html>
