<div{{ attributes }}>
	<div class="mb-3">
		<label class="form-label">Nom de la catégorie</label>
		<input type="text" class="form-control" data-model="name" value="{{ name }}" data-action="keydown.enter->live#action" data-live-action-param="save">
	</div>

	<div class="mb-3">
		<label class="form-label">Catégorie parente (optionnel)</label>
		<select class="form-select" data-model="parentCategoryId">
			<option value="">Aucune (catégorie principale)</option>
			{% for rootCategory in this.rootCategories %}
				<option value="{{ rootCategory.id }}" {% if parentCategoryId == rootCategory.id %}selected{% endif %}>{{ rootCategory.name }}</option>
			{% endfor %}
		</select>
	</div>

	{% if error %}
		<div class="alert alert-danger py-2 mb-3">{{ error }}</div>
	{% endif %}

	<div class="d-flex justify-content-end gap-2">
		<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
		<button type="button" class="btn btn-primary" data-action="live#action" data-live-action-param="save">
			{{ ux_icon('mdi:check', {'class': 'me-1'}) }}Créer la catégorie
		</button>
	</div>
</div>
