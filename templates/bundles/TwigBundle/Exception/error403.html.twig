{# templates/bundles/TwigBundle/Exception/error403.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Accès refusé{% endblock %}

{% block h1 %}Erreur 403 – Accès refusé{% endblock %}

{% block body %}
	<section class="error-page py-5" aria-labelledby="error-heading">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-md-6 mb-4 mb-md-0">
					<p class="error-page-code" aria-hidden="true">403</p>
					<h2 id="error-heading" class="error-page-title">
						Vous n'avez pas l'autorisation d'accéder à cette page.
					</h2>
					<p class="error-page-subtitle">
						Vous ne disposez pas des droits nécessaires pour consulter ce contenu.
						Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur de votre organisation.
					</p>

					<div class="d-flex flex-wrap gap-3 mb-4">
						<a href="{{ path('app_home') }}" class="btn btn-primary fs-5 px-4">
							Retour à l'accueil
						</a>
						{% if app.user %}
							<a href="{{ path('app_dashboard') }}" class="btn btn-outline-primary fs-5 px-4">
								Mon tableau de bord
							</a>
						{% else %}
							<a href="{{ path('app_login') }}" class="btn btn-outline-primary fs-5 px-4">
								Se connecter
							</a>
						{% endif %}
					</div>
          
				</div>
				<div class="col-md-6 d-flex justify-content-center">
					<img
						src="{{ asset('img/error_403.svg') }}"
						alt=""
						class="error-page-image img-fluid"
						width="500"
						height="500"
					>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
