{# templates/bundles/TwigBundle/Exception/error500.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Erreur interne{% endblock %}

{% block h1 %}Erreur 500 – Erreur interne du serveur{% endblock %}

{% block body %}
	<section class="error-page py-5" aria-labelledby="error-heading">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-md-6 mb-4 mb-md-0">
					<p class="error-page-code" aria-hidden="true">500</p>
					<h2 id="error-heading" class="error-page-title">
						Oups, quelque chose s'est mal passé.
					</h2>
					<p class="error-page-subtitle">
						Le serveur a rencontré une erreur inattendue et n'a pas pu traiter votre demande.
						Réessayez dans quelques instants.
					</p>

					<div class="d-flex flex-wrap gap-3 mb-4">
						<a href="{{ path('app_home') }}" class="btn btn-primary fs-5 px-4">
							Retour à l'accueil
						</a>
						{% if app.user %}
							<a href="{{ path('app_dashboard') }}" class="btn btn-outline-primary fs-5 px-4">
								Mon tableau de bord
							</a>
						{% else %}
							<a href="{{ path('app_login') }}" class="btn btn-outline-primary fs-5 px-4">
								Se connecter
							</a>
						{% endif %}
					</div>
          
				</div>
				<div class="col-md-6 d-flex justify-content-center">
					<img
						src="{{ asset('img/error_500.svg') }}"
						alt=""
						class="error-page-image img-fluid"
						width="500"
						height="500"
					>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
