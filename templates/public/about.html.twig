{% extends 'base.html.twig' %}

{% block title %}À propos{% endblock %}

{% block h1 %}À propos d'Arkalib{% endblock %}

{% block body %}

{# ── INTRO ── #}
<section class="py-5" aria-labelledby="about-intro-heading">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-7">
                <img
                    src="{{ asset('img/logo.svg') }}"
                    alt="Logo Arkalib"
                    width="80"
                    height="80"
                    class="mb-4"
                >
                <h2 id="about-intro-heading" class="hero-budget-title mb-3">À propos d'Arkalib</h2>
                <p class="hero-budget-subtitle">
                    Gérez vos budgets sans jargon comptable,<br aria-hidden="true">
                    en équipe ou en solo, en toute simplicité.
                </p>
            </div>
        </div>

        {# ── BLOCS ── #}
        <div class="row justify-content-center g-4">

            <div class="col-md-4">
                <article class="ark-card card h-100">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            {{ ux_icon('lucide:lightbulb', { width: '32', height: '32', class: 'svg-primary' }) }}
                        </div>
                        <h3 class="h5 card-title">Pourquoi Arkalib&nbsp;?</h3>
                        <p class="card-text">
                            Arkalib est né d'un constat simple : la gestion budgétaire ne devrait pas nécessiter 
                            de formation en comptabilité. Que vous gériez une association, un projet collectif 
                            ou une petite structure, tout est pensé pour être accessible dès le premier jour.
                        </p>
                    </div>
                </article>
            </div>

            <div class="col-md-4">
                <article class="ark-card card h-100">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            {{ ux_icon('lucide:layers', { width: '32', height: '32', class: 'svg-primary' }) }}
                        </div>
                        <h3 class="h5 card-title">Une logique intuitive</h3>
                        <p class="card-text">
                            Définissez vos enveloppes budgétaires, associez-y vos lignes de dépenses 
                            ou de recettes, et conservez une vision claire de vos finances à tout moment. 
                            Sans plan comptable, sans notion de débit ou de crédit.
                        </p>
                    </div>
                </article>
            </div>

            <div class="col-md-4">
                <article class="ark-card card h-100">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            {{ ux_icon('bi:people-fill', { width: '32', height: '32', class: 'svg-primary' }) }}
                        </div>
                        <h3 class="h5 card-title">Pensé pour les équipes</h3>
                        <p class="card-text">
                            Invitez vos collaborateurs, partagez un espace commun et assurez-vous que 
                            chacun dispose d'une vision à jour des finances. La gestion budgétaire devient 
                            enfin un effort collectif, sans friction.
                        </p>
                    </div>
                </article>
            </div>

        </div>

        {# ── CTA ── #}
        <div class="text-center mt-5">
            <p class="fs-5 fw-bold mb-4">Simple à prendre en main. Puissant quand vous en avez besoin.</p>
            <a href="{{ path('app_register') }}" class="btn btn-primary fs-5 ps-4 pe-4 me-3">
                Créer un compte
            </a>
            <a href="{{ path('app_contact') }}" class="btn btn-outline-secondary fs-5 ps-4 pe-4">
                Nous contacter
            </a>
        </div>

    </div>
</section>

{% endblock %}