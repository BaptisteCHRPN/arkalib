{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
	<div class="login-container">
		<div class="login-card">
			<h1 class="login-title">Connexion</h1>

			{% if error %}
				<div class="alert alert-danger text-center">
					{{ error.message|raw }}
				</div>
			{% endif %}

			{% if app.user %}
				<div class="text-center mb-3">
					You are logged in as
					{{ app.user.userIdentifier }},
					<a href="{{ path('app_logout') }}" class="login-link">Logout</a>
				</div>
			{% else %}
				<form method="post">
					<div class="mb-3">
						<input type="email" value="{{ last_username }}" name="email" class="form-control login-input" placeholder="Adresse e-mail" autocomplete="email" required>
					</div>

					<div class="mb-3">
						<input type="password" name="password" class="form-control login-input" placeholder="Mot de passe" autocomplete="current-password" required>
					</div>

					<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
					<div class="checkbox mb-3">
						<label>
							<input type="checkbox" name="_remember_me">
							Remember me
						</label>
					</div>
					<button class="w-100 btn btn-primary login-button" type="submit">
						Connexion
					</button>

					<div class="text-center mb-3">
						<a href="{{ path('app_forgot_password_request') }}" class="login-link">Mot de passe oublié ?</a>
					</div>

					<hr>

					<div class="text-center">
						<p class="mb-0">Pas encore de compte ?
							<a href="{{ path('app_register') }}" class="login-link">S'inscrire</a>
						</p>
					</div>
				</form>
			{% endif %}
		</div>
	</div>
{% endblock %}
