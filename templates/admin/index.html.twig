{% extends 'user_base.html.twig' %}

{% block title %}Back Office{% endblock %}

{% block body %}


{% for user in users %}
    <ul>
        <li>{{ user.firstname}} {{ user.lastname}}</li>
    </ul>

{% endfor %}



    {% for organisation in organisations %}
        <ul>
            <li>{{ organisation.name}}</li>
        </ul>
    {% else %}
        Aucune organisation trouvée.
    {% endfor %}




{% endblock %}
