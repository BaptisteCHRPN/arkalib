{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	{{ include('admin/_stylesheets.html.twig') }}
{% endblock %}

{% block title %}Gestion des transactions{% endblock %}

{% block body %}

<div class="container py-4 py-md-5">

    {# ─── Breadcrumb ─── #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_back_office') }}">Administration</a></li>
            <li class="breadcrumb-item active" aria-current="page">Transactions</li>
        </ol>
    </nav>

    {# ─── Header ─── #}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold fs-2 mb-1">Transactions</h1>
            <p class="text-secondary mb-0">Annuaire de toutes les opérations, toutes organisations confondues</p>
        </div>
    </div>

    {# ─── Table Card ─── #}
    <div class="card admin-table-card shadow-sm">

        {# Card Header #}
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark">{{ search ? 'Résultats' : 'Toutes les transactions' }}</span>
                <span class="count-badge">{{ transactions|length }}</span>
            </div>
            {{ include('admin/_search_form.html.twig', {
                route: 'app_admin_transaction_index',
                label: 'Rechercher une transaction par référence, commentaire ou moyen de paiement',
                placeholder: 'Référence ou commentaire...',
            }) }}
        </div>

        {# Table #}
        <div class="table-responsive">
            <table class="table admin-table mb-0" id="transactionTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Montant</th>
                        <th>Moyen de paiement</th>
                        <th>Référence</th>
                        <th>Commentaire</th>
                        <th>Créée le</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for transaction in transactions %}
                    <tr>
                        <td>
                            <span class="badge badge-id">#{{ transaction.id }}</span>
                        </td>
                        <td>
                            <span class="text-secondary small">{{ transaction.date ? transaction.date|date('d/m/Y') : '—' }}</span>
                        </td>
                        <td class="fw-semibold text-dark">{{ transaction.amount|number_format(2, ',', ' ') }} €</td>
                        <td>
                            <span class="text-secondary small">{{ transaction.paymentMethod ?: '—' }}</span>
                        </td>
                        <td>
                            <span class="text-secondary small">{{ transaction.reference ?: '—' }}</span>
                        </td>
                        <td>
                            <span class="text-secondary small">{{ transaction.comment ? (transaction.comment|length > 40 ? transaction.comment|slice(0, 20) ~ '…' : transaction.comment) : '—' }}</span>
                        </td>
                        <td>
                            <span class="text-secondary small">{{ transaction.createdAt ? transaction.createdAt|date('d/m/Y') : '—' }}</span>
                        </td>
                        <td>
                            {% if transaction.isActive %}
                                <span class="badge rounded-pill px-2 py-1 badge-verified">
                                    {{ ux_icon('lucide:check', { width: '12', height: '12', class: 'me-1' }) }}
                                    Active
                                </span>
                            {% else %}
                                <span class="badge rounded-pill px-2 py-1 badge-unverified">
                                    {{ ux_icon('lucide:x', { width: '12', height: '12', 'stroke-width': '2.5', class: 'me-1' }) }}
                                    Inactive
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a href="{{ path('app_admin_transaction_show', {'id': transaction.id}) }}" class="btn-action btn-show" title="Voir la fiche">
                                    {{ ux_icon('gg:eye', { width: '16', height: '16', fill: 'none', stroke: 'currentColor' }) }}
                                </a>
                                {# Une transaction n'a pas de budget à elle : il se déduit de ses
                                   lignes, et une transaction sans ligne n'est rattachable à rien. #}
                                {% set line = transaction.budgetLine|first %}
                                {% set budget = line ? line.budget : null %}
                                {% if budget and budget.organization %}
                                    <a href="{{ path('app_member_transaction_show', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug, 'id': transaction.id}) }}" class="btn-action btn-edit" title="Ouvrir dans l'interface membre">
                                        {{ ux_icon('lucide:external-link', { width: '16', height: '16', fill: 'none', stroke: 'currentColor' }) }}
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9">
                            <div class="empty-state text-center">
                                {{ ux_icon('lucide:receipt', { width: '48', height: '48', 'stroke-width': '1', class: 'mb-3' }) }}
                                {% if search %}
                                    <p class="text-secondary mb-2 fw-medium">Aucune transaction ne correspond à « {{ search }} »</p>
                                    <p class="text-muted small mb-3">La recherche porte sur la référence, le commentaire et le moyen de paiement.</p>
                                    <a href="{{ path('app_admin_transaction_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
                                        {{ ux_icon('lucide:arrow-left', { width: '16', height: '16' }) }}
                                        Voir toutes les transactions
                                    </a>
                                {% else %}
                                    <p class="text-secondary mb-2 fw-medium">Aucune transaction trouvée</p>
                                    <p class="text-muted small mb-0">Les transactions se saisissent depuis l'interface membre, dans un budget.</p>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ─── Footer ─── #}
    {% if transactions|length > 0 %}
    <div class="d-flex justify-content-between align-items-center mt-3 px-1">
        <p class="small mb-0">{{ transactions|length }} transaction{{ transactions|length > 1 ? 's' : '' }} {{ search ? 'trouvée' ~ (transactions|length > 1 ? 's' : '') : 'au total' }}</p>
        <a href="{{ path('app_back_office') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
            {{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
            Retour au tableau de bord
        </a>
    </div>
    {% endif %}
</div>

{% endblock %}
