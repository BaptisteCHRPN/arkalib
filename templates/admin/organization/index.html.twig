{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	{{ include('admin/_stylesheets.html.twig') }}
{% endblock %}

{% block title %}Gestion des organisations
{% endblock %}

{% block body %}

	<div class="container py-4 py-md-5">

		{# ─── Breadcrumb ─── #}
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb mb-0 small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_back_office') }}">Administration</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Organisations</li>
			</ol>
		</nav>

		{# ─── Header ─── #}
		<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
			<div>
				<h1 class="fw-bold fs-2 mb-1">Organisations</h1>
				<p class="text-secondary mb-0">Annuaire de toutes les structures inscrites</p>
			</div>
		</div>

		{# ─── Table Card ─── #}
		<div
			class="card admin-table-card shadow-sm">

			{# Card Header #}
			<div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
				<div class="d-flex align-items-center gap-2">
					<span class="fw-semibold text-dark">{{ search ? 'Résultats' : 'Toutes les organisations' }}</span>
					<span class="count-badge">{{ organizations|length }}</span>
				</div>

				{{ include('admin/_search_form.html.twig', {
					route: 'app_admin_organization_index',
					label: 'Rechercher une organisation par nom, slug ou description',
					placeholder: 'Nom ou slug...',
				}) }}
			</div>

			{# Table #}
			<div class="table-responsive">
				<table class="table admin-table mb-0" id="organizationTable">
					<thead>
						<tr>
							<th>ID</th>
							<th>Logo</th>
							<th>Nom</th>
							<th>Description</th>
							<th>Créée le</th>
							<th>Statut</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for organization in organizations %}
							<tr>
								<td>
									<span class="badge badge-id">#{{ organization.id }}</span>
								</td>
								<td>
									<div class="profile-rounded text-light d-inline-flex align-items-center justify-content-center">
										{% if organization.picture %}
											<img src="{{ path('organization_logo_upload', {nameFile: organization.picture}) }}" alt="">
										{% else %}
											{{ organization.name|first|upper }}
										{% endif %}
									</div>
								</td>
								<td class="fw-medium text-dark">{{ organization.name }}</td>
								<td>
									<span class="text-secondary small">{{ organization.description|length > 50 ? organization.description|slice(0, 50) ~ '…' : organization.description }}</span>
								</td>
								<td>
									<span class="text-secondary small">{{ organization.createdAt ? organization.createdAt|date('d/m/Y') : '—' }}</span>
								</td>
								<td>
									{% if organization.isActive %}
										<span class="badge rounded-pill px-2 py-1 badge-verified">
											{{ ux_icon('lucide:check', {
											    width: '12',
											    height: '12',
											    class: 'me-1',
											}) }}
											Active
										</span>
									{% else %}
										<span class="badge rounded-pill px-2 py-1 badge-unverified">
											{{ ux_icon('lucide:x', {
                                                width: '12',
                                                height: '12',
                                                'stroke-width': '2.5',
                                                class: 'me-1'
                                            }) }}
											Inactive
										</span>
									{% endif %}
								</td>
								<td class="text-end">
									<div class="d-inline-flex gap-2">
										<a href="{{ path('app_admin_organization_show', {'id': organization.id}) }}" class="btn-action btn-show" title="Voir">
											{{ ux_icon('gg:eye', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
										</a>
										<a href="{{ path('app_organization_budgets', {'organizationSlug': organization.slug}) }}" class="btn-action btn-edit" title="Ouvrir dans l'interface membre">
											{{ ux_icon('lucide:external-link', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
										</a>
									</div>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7">
									<div class="empty-state text-center">
										{{ ux_icon('heroicons:building-office', {
                                            width: '48',
                                            height: '48',
                                            'stroke-width': '1',
                                            class: 'mb-3'
                                        }) }}
										{% if search %}
											<p class="text-secondary mb-2 fw-medium">Aucune organisation ne correspond à « {{ search }} »</p>
											<p class="text-muted small mb-3">La recherche porte sur le nom, le slug et la description.</p>
											<a href="{{ path('app_admin_organization_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
												{{ ux_icon('lucide:arrow-left', { width: '16', height: '16' }) }}
												Voir toutes les organisations
											</a>
										{% else %}
											<p class="text-secondary mb-2 fw-medium">Aucune organisation trouvée</p>
											<p class="text-muted small mb-0">Les organisations se créent depuis l'interface membre.</p>
										{% endif %}
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		{# ─── Footer ─── #}
		{% if organizations|length > 0 %}
			<div class="d-flex justify-content-between align-items-center mt-3 px-1">
				<p class="small mb-0">{{ organizations|length }}
					organisation{{ organizations|length > 1 ? 's' : '' }}
					{{ search ? 'trouvée' ~ (organizations|length > 1 ? 's' : '') : 'au total' }}</p>
				<a href="{{ path('app_back_office') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
					{{ ux_icon('lucide:arrow-left', {
					    width: '14',
					    height: '14'
					}) }}
					Retour au tableau de bord
				</a>
			</div>
		{% endif %}
	</div>

{% endblock %}
