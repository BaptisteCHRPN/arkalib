{% extends 'user_base.html.twig' %}

{% block title %}organization index{% endblock %}

{% block body %}
    <h1>organization index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Created_at</th>
                <th>Is_active</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for organization in organizations %}
            <tr>
                <td>{{ organization.id }}</td>
                <td>{{ organization.name }}</td>
                <td>{{ organization.createdAt ? organization.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ organization.isActive ? 'Yes' : 'No' }}</td>
                <td>{{ organization.description }}</td>
                <td>
                    <a href="{{ path('app_admin_organization_show', {'id': organization.id}) }}">show</a>
                    <a href="{{ path('app_admin_organization_edit', {'id': organization.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_organization_new') }}">Create new</a>
{% endblock %}
