{% extends 'user_base.html.twig' %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/back-office.css') }}">
{% endblock %}

{% block title %}Gestion des catégories{% endblock %}

{% block body %}

<div class="container py-4 py-md-5">

    {# ─── Breadcrumb ─── #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_back_office') }}">Administration</a></li>
            <li class="breadcrumb-item active" aria-current="page">Catégories</li>
        </ol>
    </nav>

    {# ─── Header ─── #}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold fs-2 mb-1">Catégories</h1>
            <p class="text-secondary mb-0">Annuaire de toutes les catégories, toutes organisations confondues</p>
        </div>
    </div>

    {# ─── Table Card ─── #}
    <div class="card admin-table-card shadow-sm">

        {# Card Header with search and count #}
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark">Toutes les catégories</span>
                <span class="count-badge">{{ categories|length }}</span>
            </div>
            <input type="text" class="form-control search-input" id="searchInput" placeholder="Rechercher..." style="max-width: 260px;" onkeyup="filterTable()">
        </div>

        {# Table #}
        <div class="table-responsive">
            <table class="table admin-table mb-0" id="categoryTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Budget</th>
                        <th>Organisation</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td>
                            <span class="badge badge-id">#{{ category.id }}</span>
                        </td>
                        <td class="fw-medium text-dark">{{ category.name }}</td>
                        <td>
                            <span class="badge badge-budget rounded-pill px-2 py-1">
                                {{ category.budget.name }}
                            </span>
                        </td>
                        <td>
                            {% set organization = category.budget.organization %}
                            {% if organization %}
                                <span class="badge badge-org rounded-pill px-2 py-1">{{ organization.name }}</span>
                            {% else %}
                                <span class="text-secondary small">—</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a href="{{ path('app_admin_category_show', {'id': category.id}) }}" class="btn-action btn-show" title="Voir la fiche">
                                    {{ ux_icon('gg:eye', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
                                </a>
                                {% if organization %}
                                    <a href="{{ path('app_category_index', {'organizationSlug': organization.slug, 'budgetSlug': category.budget.slug}) }}" class="btn-action btn-edit" title="Ouvrir les catégories dans l'interface membre">
                                        {{ ux_icon('lucide:external-link', {
                                            width: '16',
                                            height: '16',
                                            fill: 'none',
                                            stroke: 'currentColor'
                                        }) }}
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">
                            <div class="empty-state text-center">
                                {{ ux_icon('akar-icons:tag', { width: '48', height: '48', 'stroke-width': '1', class: 'mb-3' }) }}
                                <p class="text-secondary mb-2 fw-medium">Aucune catégorie trouvée</p>
                                <p class="text-muted small mb-0">Les catégories se créent depuis l'interface membre, dans un budget.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ─── Footer info ─── #}
    {% if categories|length > 0 %}
    <div class="d-flex justify-content-between align-items-center mt-3 px-1">
        <p class="small mb-0">{{ categories|length }} catégorie{{ categories|length > 1 ? 's' : '' }} au total</p>
        <a href="{{ path('app_back_office') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
            {{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
            Retour au tableau de bord
        </a>
    </div>
    {% endif %}
</div>

{# ─── Search script ─── #}
<script>
function filterTable() {
    const input = document.getElementById('searchInput').value.toLowerCase();
    const rows = document.querySelectorAll('#categoryTable tbody tr');
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
    });
}
</script>

{% endblock %}
