{% extends 'user_base.html.twig' %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/back-office.css') }}">
{% endblock %}

{% block title %}Gestion des catégories{% endblock %}

{% block body %}

<div class="container py-4 py-md-5">

    {# ─── Breadcrumb ─── #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_back_office') }}">Administration</a></li>
            <li class="breadcrumb-item active" aria-current="page">Catégories</li>
        </ol>
    </nav>

    {# ─── Header ─── #}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold fs-2 mb-1">Catégories</h1>
            <p class="text-secondary mb-0">Gestion des catégories de dépense et de recette</p>
        </div>
        <a href="{{ path('app_admin_category_new') }}" class="btn btn-create text-white d-inline-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            Nouvelle catégorie
        </a>
    </div>

    {# ─── Table Card ─── #}
    <div class="card admin-table-card shadow-sm">

        {# Card Header with search and count #}
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark">Toutes les catégories</span>
                <span class="count-badge">{{ categories|length }}</span>
            </div>
            <input type="text" class="form-control search-input" id="searchInput" placeholder="Rechercher..." style="max-width: 260px;" onkeyup="filterTable()">
        </div>

        {# Table #}
        <div class="table-responsive">
            <table class="table admin-table mb-0" id="categoryTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Budget</th>
                        <th>Organisation</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td>
                            <span class="badge badge-id">#{{ category.id }}</span>
                        </td>
                        <td class="fw-medium text-dark">{{ category.name }}</td>
                        <td>
                            <span class="badge badge-budget rounded-pill px-2 py-1">
                                {{ category.budget.name }}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge-org rounded-pill px-2 py-1">
                                {{ category.budget.organization.name }}
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a href="{{ path('app_admin_category_show', {'id': category.id}) }}" class="btn-action btn-show" title="Voir">
                                    {{ ux_icon('gg:eye', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
                                </a>
                                <a href="{{ path('app_admin_category_edit', {'id': category.id}) }}" class="btn-action btn-edit" title="Modifier">
                                    {{ ux_icon('lucide:edit', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">
                            <div class="empty-state text-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="mb-3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"/>
                                </svg>
                                <p class="text-secondary mb-2 fw-medium">Aucune catégorie trouvée</p>
                                <p class="text-muted small mb-3">Commencez par créer votre première catégorie.</p>
                                <a href="{{ path('app_admin_category_new') }}" class="btn btn-sm btn-create text-white d-inline-flex align-items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                                    </svg>
                                    Créer une catégorie
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ─── Footer info ─── #}
    {% if categories|length > 0 %}
    <div class="d-flex justify-content-between align-items-center mt-3 px-1">
        <p class="small mb-0">{{ categories|length }} catégorie{{ categories|length > 1 ? 's' : '' }} au total</p>
        <a href="{{ path('app_back_office') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            Retour au tableau de bord
        </a>
    </div>
    {% endif %}
</div>

{# ─── Search script ─── #}
<script>
function filterTable() {
    const input = document.getElementById('searchInput').value.toLowerCase();
    const rows = document.querySelectorAll('#categoryTable tbody tr');
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
    });
}
</script>

{% endblock %}
