{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/back-office.css') }}">
{% endblock %}

{% block title %}Modifier – {{ category.name }}{% endblock %}

{% block body %}
	<div class="container py-4 py-md-5">

		{# ─── Breadcrumb ─── #}
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb mb-0 small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_back_office') }}">Administration</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('app_admin_category_index') }}">Catégories</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('app_admin_category_show', {'id': category.id}) }}">{{ category.name }}</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Modifier</li>
			</ol>
		</nav>

		{# ─── Header ─── #}
		<div class="mb-4">
			<h1 class="fw-bold fs-2 mb-0">Modifier la catégorie</h1>
		</div>

		{# ─── Form Card ─── #}
		<div class="card admin-table-card shadow-sm">
			<div class="card-header">
				<span class="fw-semibold text-dark">{{ category.name }}</span>
			</div>
			<div class="card-body p-4">
				{{ include('admin/category/_form.html.twig', {'button_label': 'Enregistrer'}) }}
			</div>
		</div>

		{# ─── Footer ─── #}
		<div class="d-flex justify-content-between align-items-center mt-3 px-1">
			<a href="{{ path('app_admin_category_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
				Retour à la liste
			</a>
			{{ include('admin/category/_delete_form.html.twig') }}
		</div>

	</div>
{% endblock %}
