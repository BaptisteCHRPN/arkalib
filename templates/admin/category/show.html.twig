{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/back-office.css') }}">
{% endblock %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
	<div class="container py-4 py-md-5">

		{# ─── Breadcrumb ─── #}
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb mb-0 small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_back_office') }}">Administration</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('app_admin_category_index') }}">Catégories</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
			</ol>
		</nav>

		{# ─── Header ─── #}
		<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
			<div class="d-flex align-items-center gap-3">
				<div class="profile-rounded text-light d-inline-flex align-items-center justify-content-center" style="width:48px;height:48px;font-size:1.1rem;">
					{{ category.name|first|upper }}
				</div>
				<div>
					<h1 class="fw-bold fs-2 mb-1">{{ category.name }}</h1>
					<p class="text-secondary mb-0">{{ category.budget ? category.budget.name : '—' }}</p>
				</div>
			</div>
			<a href="{{ path('app_admin_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:edit', { width: '14', height: '14' }) }}
				Modifier
			</a>
		</div>

		{# ─── Detail Card ─── #}
		<div class="card admin-table-card shadow-sm">
			<div class="card-header">
				<span class="fw-semibold text-dark">Informations de la catégorie</span>
			</div>
			<div class="table-responsive">
				<table class="table admin-table mb-0">
					<tbody>
						<tr>
							<th class="text-secondary fw-normal" style="width:220px;">ID</th>
							<td>
								<span class="badge badge-id">#{{ category.id }}</span>
							</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Nom</th>
							<td class="fw-medium text-dark">{{ category.name }}</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Budget</th>
							<td class="text-secondary">{{ category.budget ? category.budget.name : '—' }}</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Catégorie parente</th>
							<td class="text-secondary">{{ category.parentCategory ? category.parentCategory.name : '—' }}</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Sous-catégories</th>
							<td class="text-secondary">{{ category.subCategories|length }}</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Lignes budgétaires</th>
							<td class="text-secondary">{{ category.budgetLines|length }}</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		{# ─── Footer ─── #}
		<div class="d-flex justify-content-between align-items-center mt-3 px-1">
			<a href="{{ path('app_admin_category_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
				Retour à la liste
			</a>
			{{ include('admin/category/_delete_form.html.twig') }}
		</div>

	</div>
{% endblock %}
