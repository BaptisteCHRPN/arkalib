    {# <div class="d-flex flex-wrap gap-2 mb-4">
        <span class="badge rounded-pill bg-light text-secondary border d-inline-flex align-items-center gap-2 px-3 py-2 fw-medium">
            <span class="rounded-circle d-inline-block" style="width:8px;height:8px;background:#22c55e;"></span>
            Système opérationnel
        </span>
        <span class="badge rounded-pill bg-light text-secondary border d-inline-flex align-items-center gap-2 px-3 py-2 fw-medium">
            <span class="rounded-circle d-inline-block" style="width:8px;height:8px;background:#3b82f6;"></span>
            6 modules actifs
        </span>
    </div> #}

