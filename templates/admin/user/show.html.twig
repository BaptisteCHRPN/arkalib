{% import 'macros/avatar.html.twig' as avatarMacros %}
{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/back-office.css') }}">
{% endblock %}

{% block title %}{{ user.firstname }} {{ user.lastname }}{% endblock %}

{% block body %}
	<div class="container py-4 py-md-5">

		{# ─── Breadcrumb ─── #}
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb mb-0 small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_back_office') }}">Administration</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('app_user_index') }}">Utilisateurs</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">{{ user.firstname }} {{ user.lastname }}</li>
			</ol>
		</nav>

		{# ─── Header ─── #}
		<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
			<div class="d-flex align-items-center gap-3">
				{{ avatarMacros.user_avatar(user.picture, user.email, 56) }}
				<div>
					<h1 class="fw-bold fs-2 mb-1">{{ user.firstname }} {{ user.lastname }}</h1>
					<p class="text-secondary mb-0">{{ user.email }}</p>
				</div>
			</div>
			<a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:edit', { width: '14', height: '14' }) }}
				Modifier
			</a>
		</div>

		{# ─── Detail Card ─── #}
		<div class="card admin-table-card shadow-sm">
			<div class="card-header">
				<span class="fw-semibold text-dark">Informations du compte</span>
			</div>
			<div class="table-responsive">
				<table class="table admin-table mb-0">
					<tbody>
						<tr>
							<th class="text-secondary fw-normal" style="width:220px;">ID</th>
							<td>
								<span class="badge badge-id">#{{ user.id }}</span>
							</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Prénom</th>
							<td class="fw-medium text-dark">{{ user.firstname }}</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Nom</th>
							<td class="fw-medium text-dark">{{ user.lastname }}</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Email</th>
							<td>
								<span class="text-secondary">{{ user.email }}</span>
							</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Rôles</th>
							<td>
								{% for role in user.roles %}
									{% if role == 'ROLE_ADMIN' %}
										<span class="badge rounded-pill px-2 py-1 badge-role-admin">Admin</span>
									{% elseif role == 'ROLE_SUPER_ADMIN' %}
										<span class="badge rounded-pill px-2 py-1 badge-role-superadmin">Super Admin</span>
									{% elseif role == 'ROLE_USER' %}
										<span class="badge rounded-pill px-2 py-1 badge-role-user">Utilisateur</span>
									{% else %}
										<span class="badge rounded-pill px-2 py-1 badge-id">{{ role }}</span>
									{% endif %}
								{% endfor %}
							</td>
						</tr>
						<tr>
							<th class="text-secondary fw-normal">Compte vérifié</th>
							<td>
								{% if user.isVerified %}
									<span class="badge rounded-pill px-2 py-1 badge-verified">
										{{ ux_icon('lucide:check', { width: '12', height: '12', class: 'me-1' }) }}
										Vérifié
									</span>
								{% else %}
									<span class="badge rounded-pill px-2 py-1 badge-unverified">
										{{ ux_icon('lucide:x', { width: '12', height: '12', class: 'me-1' }) }}
										Non vérifié
									</span>
								{% endif %}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		{# ─── Footer ─── #}
		<div class="d-flex justify-content-between align-items-center mt-3 px-1">
			<a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
				Retour à la liste
			</a>
			{{ include('admin/user/_delete_form.html.twig') }}
		</div>

	</div>
{% endblock %}
