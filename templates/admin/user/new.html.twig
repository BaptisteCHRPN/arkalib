{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	{{ include('admin/_stylesheets.html.twig') }}
{% endblock %}

{% block title %}Créer un utilisateur{% endblock %}

{% block body %}
	<div class="container py-4 py-md-5">

		{# ─── Breadcrumb ─── #}
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb mb-0 small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_back_office') }}">Administration</a>
				</li>
				<li class="breadcrumb-item">
					<a href="{{ path('app_user_index') }}">Utilisateurs</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Nouveau</li>
			</ol>
		</nav>

		{# ─── Header ─── #}
		<div class="mb-4">
			<h1 class="fw-bold fs-2 mb-1">Créer un utilisateur</h1>
			<p class="text-secondary mb-0">Le compte est ouvert immédiatement ; la personne choisit elle-même son mot de passe.</p>
		</div>

		{# ─── Form Card ─── #}
		<div class="card admin-table-card shadow-sm">
			<div class="card-header">
				<span class="fw-semibold text-dark">Informations du compte</span>
			</div>
			<div class="card-body p-4">
				{{ form_start(form) }}
					{{ form_widget(form) }}

					<div class="d-flex align-items-start gap-2 text-secondary small mt-3 mb-4">
						{{ ux_icon('lucide:info', { width: '16', height: '16', class: 'flex-shrink-0 mt-1' }) }}
						<span>
							Aucun mot de passe ne vous est demandé : un lien d'initialisation
							part à l'adresse saisie. Vous pourrez le renvoyer depuis la fiche
							du compte si l'e-mail se perd.
						</span>
					</div>

					<button class="btn btn-create text-white d-inline-flex align-items-center gap-2">
						{{ ux_icon('lucide:plus', { width: '16', height: '16' }) }}
						Créer le compte
					</button>
				{{ form_end(form) }}
			</div>
		</div>

		{# ─── Footer ─── #}
		<div class="d-flex justify-content-between align-items-center mt-3 px-1">
			<a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
				Retour à la liste
			</a>
		</div>

	</div>
{% endblock %}
