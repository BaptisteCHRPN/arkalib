{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/back-office.css') }}">
{% endblock %}

{% block title %}Gestion des utilisateurs
{% endblock %}

{% block body %}

	<div
		class="container py-4 py-md-5">

		{# ─── Breadcrumb ─── #}
		<nav aria-label="breadcrumb" class="mb-3">
			<ol class="breadcrumb mb-0 small">
				<li class="breadcrumb-item">
					<a href="{{ path('app_back_office') }}">Administration</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Utilisateurs</li>
			</ol>
		</nav>

		{# ─── Header ─── #}
		<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
			<div>
				<h1 class="fw-bold fs-2 mb-1">Utilisateurs</h1>
				<p class="text-secondary mb-0">Gestion des comptes, rôles et permissions</p>
			</div>
			<a href="{{ path('app_user_new') }}" class="btn btn-create text-white d-inline-flex align-items-center gap-2">
				{{ ux_icon('lucide:plus', {
				    width: '18',
				    height: '18'
				}) }}
				Nouvel utilisateur
			</a>
		</div>

		{# ─── Table Card ─── #}
		<div
			class="card admin-table-card shadow-sm">

			{# Card Header #}
			<div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
				<div class="d-flex align-items-center gap-2">
					<span class="fw-semibold text-dark">Tous les utilisateurs</span>
					<span class="count-badge">{{ users|length }}</span>
				</div>
				<input type="text" class="form-control search-input" id="searchInput" placeholder="Rechercher..." style="max-width: 260px;" onkeyup="filterTable()">
			</div>

			{# Table #}
			<div class="table-responsive">
				<table class="table admin-table mb-0" id="userTable">
					<thead>
						<tr>
							<th>ID</th>
							<th>photo</th>
							<th>Nom</th>
							<th>Email</th>
							<th>Rôles</th>
							<th>Vérifié</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for user in users %}
							<tr>
								<td>
									<span class="badge badge-id">#{{ user.id }}</span>
								</td>
								<td>
									<div class="profile-rounded text-light d-inline-flex align-items-center justify-content-center text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
										{% if user.picture %}
											<img src="{{ path('user_avatar_upload', {nameFile: user.picture}) }}" alt="">
										{% else %}
											{{ user.firstname|first }}{{ user.lastname|first }}
										{% endif %}
									</div>
								</td>
								<td class="fw-medium text-dark">{{ user.firstname }}
									{{ user.lastname }}</td>
								<td>
									<span class="text-secondary">{{ user.email }}</span>
								</td>
								<td>
									{% for role in user.roles %}
										{% if role == 'ROLE_ADMIN' %}
											<span class="badge rounded-pill px-2 py-1 badge-role-admin">Admin</span>
										{% elseif role == 'ROLE_SUPER_ADMIN' %}
											<span class="badge rounded-pill px-2 py-1 badge-role-superadmin">Super Admin</span>
										{% elseif role == 'ROLE_USER' %}
											<span class="badge rounded-pill px-2 py-1 badge-role-user">Utilisateur</span>
										{% else %}
											<span class="badge rounded-pill px-2 py-1 badge-id">{{ role }}</span>
										{% endif %}
									{% endfor %}
								</td>
								<td>
									{% if user.isVerified %}
										<span class="badge rounded-pill px-2 py-1 badge-verified">
											{{ ux_icon('lucide:check', {
											    width: '12',
											    height: '12',
											    class: 'me-1'
											}) }}
											Vérifié
										</span>
									{% else %}
										<span class="badge rounded-pill px-2 py-1 badge-unverified">
											{{ ux_icon('lucide:x', {
											    width: '12',
											    height: '12',
 											    class: 'me-1'
											}) }}
											Non vérifié
										</span>
									{% endif %}
								</td>
								<td class="text-end">
									<div class="d-inline-flex gap-2">
										<a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn-action btn-show" title="Voir">
											{{ ux_icon('gg:eye', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
										</a>
										<a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn-action btn-edit" title="Modifier">
											{{ ux_icon('lucide:edit', {
                                        width: '16',
                                        height: '16',
                                        fill: 'none',
                                        stroke: 'currentColor'
                                    }) }}
										</a>
									</div>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6">
									<div class="empty-state text-center">
										{{ ux_icon('heroicons:users', {
										    width: '48',
										    height: '48',
										    'stroke-width': '1',
										    class: 'mb-3'
										}) }}
										<p class="text-secondary mb-2 fw-medium">Aucun utilisateur trouvé</p>
										<p class="text-muted small mb-3">Commencez par créer votre premier utilisateur.</p>
										<a href="{{ path('app_user_new') }}" class="btn btn-sm btn-create text-white d-inline-flex align-items-center gap-2">
											{{ ux_icon('lucide:plus', {
											    width: '16',
											    height: '16'
											}) }}
											Créer un utilisateur
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		{# ─── Footer ─── #}
		{% if users|length > 0 %}
			<div class="d-flex justify-content-between align-items-center mt-3 px-1">
				<p class="small mb-0">{{ users|length }}
					utilisateur{{ users|length > 1 ? 's' : '' }}
					au total</p>
				<a href="{{ path('app_back_office') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
					{{ ux_icon('lucide:arrow-left', {
					    width: '14',
					    height: '14'
					}) }}
					Retour au tableau de bord
				</a>
			</div>
		{% endif %}
	</div>

	{# ─── Search script ─── #}
	<script>
		function filterTable()
{
const input = document.getElementById('searchInput').value.toLowerCase();
const rows = document.querySelectorAll('#userTable tbody tr');
rows.forEach(row => {
const text = row.textContent.toLowerCase();
row.style.display = text.includes(input) ? '' : 'none';
});
}
	</script>

{% endblock %}
