{% extends 'user_base.html.twig' %}

{% block title %}BudgetLine{% endblock %}

{% block body %}
    <h1>BudgetLine</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ budget_line.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ budget_line.name }}</td>
            </tr>
            <tr>
                <th>Is_expense</th>
                <td>{{ budget_line.isExpense ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Descrption</th>
                <td>{{ budget_line.descrption }}</td>
            </tr>
            <tr>
                <th>Amount</th>
                <td>{{ budget_line.amount }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ budget_line.createdAt ? budget_line.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Is_active</th>
                <td>{{ budget_line.isActive ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_budget_line_index') }}">back to list</a>

    <a href="{{ path('app_admin_budget_line_edit', {'id': budget_line.id}) }}">edit</a>

    {{ include('admin/budget_line/_delete_form.html.twig') }}
{% endblock %}
