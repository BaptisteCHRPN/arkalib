{% extends 'user_base.html.twig' %}

{% block stylesheets %}
	{{ include('admin/_stylesheets.html.twig') }}
{% endblock %}

{% block title %}Gestion des budgets{% endblock %}

{% block body %}

<div class="container py-4 py-md-5">

    {# ─── Breadcrumb ─── #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ path('app_back_office') }}">Administration</a></li>
            <li class="breadcrumb-item active" aria-current="page">Budgets</li>
        </ol>
    </nav>

    {# ─── Header ─── #}
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold fs-2 mb-1">Budgets</h1>
            <p class="text-secondary mb-0">Annuaire de tous les budgets, toutes organisations confondues</p>
        </div>
    </div>

    {# ─── Table Card ─── #}
    <div class="card admin-table-card shadow-sm">

        {# Card Header #}
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark">{{ search ? 'Résultats' : 'Tous les budgets' }}</span>
                <span class="count-badge">{{ budgets|length }}</span>
            </div>
            {{ include('admin/_search_form.html.twig', {
                route: 'app_admin_budget_index',
                label: 'Rechercher un budget par nom, slug ou organisation',
                placeholder: 'Budget ou organisation...',
            }) }}
        </div>

        {# Table #}
        <div class="table-responsive">
            <table class="table admin-table mb-0" id="budgetTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Date début</th>
                        <th>Date fin</th>
                        <th>Organisation</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for budget in budgets %}
                    <tr>
                        <td>
                            <span class="badge badge-id">#{{ budget.id }}</span>
                        </td>
                        <td class="fw-medium text-dark">{{ budget.name }}</td>
                        <td>
                            <span class="text-secondary small">{{ budget.startDate ? budget.startDate|date('d/m/Y') : '—' }}</span>
                        </td>
                        <td>
                            <span class="text-secondary small">{{ budget.endDate ? budget.endDate|date('d/m/Y') : '—' }}</span>
                        </td>
                        <td>
                            {% if budget.organization %}
                                {# Le d-flex reste sur un div : un td en display:flex sort du
                                   modèle de tableau et sa colonne cesse de s'aligner. #}
                                <div class="d-flex align-items-center gap-2">
                                    <div class="profile-rounded text-light d-inline-flex align-items-center justify-content-center">
                                        {% if budget.organization.picture %}
                                            <img src="{{ path('organization_logo_upload', {nameFile: budget.organization.picture}) }}" alt="">
                                        {% else %}
                                            {{ budget.organization.name|first|upper }}
                                        {% endif %}
                                    </div>
                                    <span class="text-secondary small">{{ budget.organization.name }}</span>
                                </div>
                            {% else %}
                                <span class="text-secondary small">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if budget.isActive %}
                                <span class="badge rounded-pill px-2 py-1 badge-verified">
                                    {{ ux_icon('lucide:check', { width: '12', height: '12', class: 'me-1' }) }}
                                    Actif
                                </span>
                            {% else %}
                                <span class="badge rounded-pill px-2 py-1 badge-unverified">
                                    {{ ux_icon('lucide:x', { width: '12', height: '12', 'stroke-width': '2.5', class: 'me-1' }) }}
                                    Inactif
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a href="{{ path('app_admin_budget_show', {'id': budget.id}) }}" class="btn-action btn-show" title="Voir la fiche">
                                    {{ ux_icon('gg:eye', { width: '16', height: '16', fill: 'none', stroke: 'currentColor' }) }}
                                </a>
                                {% if budget.organization %}
                                    <a href="{{ path('app_membre_budget_show', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" class="btn-action btn-edit" title="Ouvrir dans l'interface membre">
                                        {{ ux_icon('lucide:external-link', { width: '16', height: '16', fill: 'none', stroke: 'currentColor' }) }}
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="empty-state text-center">
                                {{ ux_icon('heroicons:banknotes', { width: '48', height: '48', 'stroke-width': '1', class: 'mb-3' }) }}
                                {% if search %}
                                    <p class="text-secondary mb-2 fw-medium">Aucun budget ne correspond à « {{ search }} »</p>
                                    <p class="text-muted small mb-3">La recherche porte sur le nom, le slug et l'organisation.</p>
                                    <a href="{{ path('app_admin_budget_index') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
                                        {{ ux_icon('lucide:arrow-left', { width: '16', height: '16' }) }}
                                        Voir tous les budgets
                                    </a>
                                {% else %}
                                    <p class="text-secondary mb-2 fw-medium">Aucun budget trouvé</p>
                                    <p class="text-muted small mb-0">Les budgets se créent depuis l'interface membre, dans une organisation.</p>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ─── Footer ─── #}
    {% if budgets|length > 0 %}
    <div class="d-flex justify-content-between align-items-center mt-3 px-1">
        <p class="small mb-0">{{ budgets|length }} budget{{ budgets|length > 1 ? 's' : '' }} {{ search ? 'trouvé' ~ (budgets|length > 1 ? 's' : '') : 'au total' }}</p>
        <a href="{{ path('app_back_office') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-2">
            {{ ux_icon('lucide:arrow-left', { width: '14', height: '14' }) }}
            Retour au tableau de bord
        </a>
    </div>
    {% endif %}
</div>

{% endblock %}
