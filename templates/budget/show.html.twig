{% extends 'user_base.html.twig' %}

{% block title %}Budget{% endblock %}

{% block body %}
    <h1>Budget</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ budget.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ budget.name }}</td>
            </tr>
            <tr>
                <th>Start_date</th>
                <td>{{ budget.startDate ? budget.startDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>End_date</th>
                <td>{{ budget.endDate ? budget.endDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Is_active</th>
                <td>{{ budget.isActive ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_budget_index') }}">back to list</a>

    <a href="{{ path('app_budget_edit', {'id': budget.id}) }}">edit</a>

    {{ include('budget/_delete_form.html.twig') }}
{% endblock %}
