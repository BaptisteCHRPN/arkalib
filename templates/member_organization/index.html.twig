{% extends 'user_base.html.twig' %}

{% block title %}Vos organisations{% endblock %}

{% block body %}
<h1 class="hero-budget-title">Pour quelle association allez vous travailler aujourd'hui ?</h1>

    
<div class="container">
    <div class="row justify-content-center">
        {% for organization in organizations %}
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card text-center">
                    <div class="card-body d-flex flex-column align-items-center">
                        <span class="profile-rounded text-light d-inline-flex align-items-center justify-content-center mb-3">
                            {{ organization.name|first|capitalize }}
                        </span>
                        <h5 class="card-title mb-3">{{ organization.name|capitalize }}</h5>
                        <p class="card-text mb-3">{{ organization.description }}</p>
                        <a href="{{ path('app_organization_show', {'id': organization.id}) }}" class="btn btn-primary">Ouvrir</a>
                    </div>
                </div>
            </div>
        {% else %}
    </div>
</div>


    <p colspan="6">Aucune organisation trouvée.</p>
{% endfor %}
    <a class="btn btn-primary" href="{{ path('app_membre_organization_new') }}">Créer une nouvelle organisation</a>
{% endblock %}
