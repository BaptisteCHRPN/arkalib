{% extends 'user_base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>User</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>IsVerified</th>
                <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Firstname</th>
                <td>{{ user.firstname }}</td>
            </tr>
            <tr>
                <th>Lastname</th>
                <td>{{ user.lastname }}</td>
            </tr>
        </tbody>
    </table>

    {# Ces deux liens pointaient vers le back-office : « back to list » vers la
       liste de tous les comptes, « edit » vers le formulaire d'administration.
       Un membre n'y a pas accès, il récoltait donc un 403 sur sa propre fiche. #}
    <a href="{{ path('app_dashboard') }}">Retour au tableau de bord</a>

    <a href="{{ path('app_member_user_edit', {'id': user.id}) }}">Modifier mon profil</a>

    {{ include('member/user/_delete_form.html.twig') }}
{% endblock %}
