<div
	class="budget-view-mobile">
	{# Header #}
	<div class="text-center mb-4 px-3 pt-3">
		<h1 class="h5 fw-bold text-dark mb-1">{{ organization.name|title }}</h1>
		<h2 class="h4 fw-bold text-primary mb-2">{{ budget.name|title }}
			- Vue prévisionelle</h2>
		<p class="text-secondary small mb-0">
			{{ ux_icon('mdi:calendar-range', {'class': 'me-1'}) }}
			Du
			{{ budget.startDate|date('d/m/Y') }}
			au
			{{ budget.endDate|date('d/m/Y') }}
		</p>
	</div>

	<hr
	class="my-3">

	{# Summary #}
	<div
		class="px-3 mb-3">
		{# Total incomes #}
		<div class="d-flex justify-content-between align-items-center bg-white border border-success border-opacity-25 rounded p-3 mb-2">
			<div class="d-flex align-items-center">
				{{ ux_icon('mdi:arrow-up-circle', {'class': 'text-success fs-5 me-2'}) }}
				<span class="fw-medium">Total Recettes :</span>
			</div>
			<span class="fw-bold text-success">+
				{{ sum_incomes|number_format(0, ',', ' ') }}
				€</span>
		</div>

		{# Total expenses #}
		<div class="d-flex justify-content-between align-items-center bg-white border border-danger border-opacity-25 rounded p-3 mb-2">
			<div class="d-flex align-items-center">
				{{ ux_icon('mdi:arrow-down-circle', {'class': 'text-danger fs-5 me-2'}) }}
				<span class="fw-medium">Total Dépenses :</span>
			</div>
			<span class="fw-bold text-danger">-
				{{ sum_expenses|number_format(0, ',', ' ') }}
				€</span>
		</div>

		{# Balance #}
		<div class="d-flex justify-content-between align-items-center bg-white border border-{% if balance_budget > 0 %}success{% elseif balance_budget < 0 %}danger{% else %}secondary{% endif %} border-opacity-25 rounded p-3 mb-3">
			<div class="d-flex align-items-center">
				{{ ux_icon('mdi:piggy-bank', {'class': '{% if balance_budget > 0 %}text-success{% elseif balance_budget < 0 %}text-danger{% else %}text-secondary{% endif %} fs-5 me-2'}) }}
				<span class="fw-medium">Solde :</span>
			</div>
			<span class="fw-bold {% if balance_budget > 0 %}text-success{% elseif balance_budget < 0 %}text-danger{% else %}text-secondary{% endif %}">
				{% if balance_budget > 0 %}+
				{% endif %}
				{{ balance_budget|number_format(0, ',', ' ') }}
				€
			</span>
		</div>
	</div>

	{# CTA buttons #}
	<div class="px-3 mb-4">
		<div class="row g-2">
			<div class="col-6">
				<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-primary w-100 py-2 small">
					Ajouter une dépense
				</a>
			</div>
			<div class="col-6">
				<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-primary w-100 py-2 small">
					Ajouter une recette
				</a>
			</div>
		</div>
		<div class="mt-2">
			<a href="{{ path('app_category_new', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" class="btn btn-outline-primary w-100 py-2 small">
				Créer une catégorie
			</a>
		</div>
		<div class="mt-2">
			<a href="{{ path('app_member_transaction_index', { 'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug }) }}" class="btn btn-outline-primary">
					{{ ux_icon('hugeicons:transaction', {'class': 'me-2'}) }}
					Voir les transactions
				</a>
		</div>
		<div class="mt-2">
			<a href="{{ path('app_membre_actuel_budget_show', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-primary w-100">{{ ux_icon('tabler:arrows-diff', {'class': 'me-2'}) }}Prévu vs Réel</a>
		</div>
	</div>

	{# Incomes #}
	<div class="mb-4">
		<h3 class="h6 fw-bold text-success bg-success bg-opacity-10 p-3 mb-0">
			Recettes prévisionnelles
			<span class="badge bg-success float-end">{{ incomes|length }}</span>
		</h3>

		{% if incomes|length > 0 %}
			{% for income in incomes %}
				<div class="border-bottom bg-white">
					<div class="d-flex justify-content-between align-items-start p-3">
						<div class="flex-grow-1 me-2">
							<div class="d-flex align-items-center mb-1">
								<h4 class="h6 fw-medium mb-0 me-2">{{ income.name }}</h4>
								{% if not income.isActive %}
									<span class="badge bg-secondary" title="Ligne inactive">
										{{ ux_icon('mdi:pause-circle') }}
									</span>
								{% endif %}
							</div>

							{% if income.category %}
								<div class="mb-1">
									{% if income.category.parentCategory %}
										<span class="badge bg-light text-dark small">
											{{ income.category.parentCategory.name }}
										</span>
										{{ ux_icon('mdi:chevron-right', {'class': 'small text-secondary'}) }}
									{% endif %}
									<span class="badge bg-success bg-opacity-25 text-success small">
										{{ income.category.name }}
									</span>
								</div>
							{% endif %}

						</div>
						<div class="text-end">
							<span class="fw-bold text-success d-block text-nowrap">+
								{{ income.amount|number_format(2, ',', ' ') }}
								€</span>
							<div class="dropdown">
								<button class="btn btn-sm btn-light mt-1" type="button" id="dropdownIncome{{ income.id }}" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
									{{ ux_icon('mdi:dots-vertical') }}
								</button>
								<ul class="dropdown-menu dropdown-menu-end shadow">
									<li>
										<a class="dropdown-item" href="{{ path('app_budget_line_show', { 'organizationSlug': organization.slug, 'budgetSlug': budget.slug, 'id': income.id }) }}">
											{{ ux_icon('mdi:eye', {'class': 'me-2'}) }}Voir
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_budget_line_edit', {'id': income.id, 'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}">
											{{ ux_icon('mdi:pencil', {'class': 'me-2'}) }}Modifier
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_transaction_new', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
											{{ ux_icon('hugeicons:transaction', {'class': 'me-2'}) }}Ajouter une transaction
										</a>
									</li>
									<li><hr class="dropdown-divider"></li>
									<li>
										{% include "member/budget_line/_delete_form.html.twig" with {'budgetLine': income} %}
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}

			<div class="bg-light p-3">
				<div class="d-flex justify-content-between align-items-center">
					<span class="fw-bold">Total des recettes :</span>
					<span class="fw-bold text-success">+
						{{ sum_incomes|number_format(2, ',', ' ') }}
						€</span>
				</div>
			</div>
		{% else %}
			<div class="text-center py-5 bg-white">
				{{ ux_icon('mdi:inbox', {'class': 'text-secondary', 'style': 'font-size: 3rem;'}) }}
				<p class="text-secondary mt-3 mb-0">Aucune recette trouvée</p>
				<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-sm btn-outline-success mt-3">
					{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}
					Ajouter une recette
				</a>
			</div>
		{% endif %}
	</div>

	{# Expenses #}
	<div class="mb-4">
		<h3 class="h6 fw-bold text-danger bg-danger bg-opacity-10 p-3 mb-0">
			Dépenses prévisionnelles
			<span class="badge bg-danger float-end">{{ expenses|length }}</span>
		</h3>

		{% if expenses|length > 0 %}
			{% for expense in expenses %}
				<div class="border-bottom bg-white">
					<div class="d-flex justify-content-between align-items-start p-3">
						<div class="flex-grow-1 me-2">
							<div class="d-flex align-items-center mb-1">
								<h4 class="h6 fw-medium mb-0 me-2">{{ expense.name }}</h4>
								{% if not expense.isActive %}
									<span class="badge bg-secondary" title="Ligne inactive">
										{{ ux_icon('mdi:pause-circle') }}
									</span>
								{% endif %}
							</div>

							{% if expense.category %}
								<div class="mb-1">
									{% if expense.category.parentCategory %}
										<span class="badge bg-light text-dark small">
											{{ expense.category.parentCategory.name }}
										</span>
										{{ ux_icon('mdi:chevron-right', {'class': 'small text-secondary'}) }}
									{% endif %}
									<span class="badge bg-danger bg-opacity-25 text-danger small">
										{{ expense.category.name }}
									</span>
								</div>
							{% endif %}

						</div>
						<div class="text-end">
							<span class="fw-bold text-danger d-block text-nowrap">-
								{{ expense.amount|number_format(2, ',', ' ') }}
								€</span>
							<div class="dropdown">
								<button class="btn btn-sm btn-light mt-1" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
									{{ ux_icon('mdi:dots-vertical') }}
								</button>
								<ul class="dropdown-menu dropdown-menu-end shadow">
									<li>
										<a class="dropdown-item" href="{{ path('app_budget_line_show', { 'organizationSlug': organization.slug, 'budgetSlug': budget.slug, 'id': expense.id }) }}">
											{{ ux_icon('mdi:eye', {'class': 'me-2'}) }}Voir
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_budget_line_edit', {'id': expense.id, 'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}">
											{{ ux_icon('mdi:pencil', {'class': 'me-2'}) }}Modifier
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_transaction_new', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
											{{ ux_icon('hugeicons:transaction', {'class': 'me-2'}) }}Ajouter une transaction
										</a>
									</li>
									<li><hr class="dropdown-divider"></li>
									<li>
										{% include "member/budget_line/_delete_form.html.twig" with {'budgetLine': expense} %}
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}

			<div class="bg-light p-3">
				<div class="d-flex justify-content-between align-items-center">
					<span class="fw-bold">Total des dépenses :</span>
					<span class="fw-bold text-danger">-
						{{ sum_expenses|number_format(2, ',', ' ') }}
						€</span>
				</div>
			</div>
		{% else %}
			<div class="text-center py-5 bg-white">
				{{ ux_icon('mdi:inbox', {'class': 'text-secondary', 'style': 'font-size: 3rem;'}) }}
				<p class="text-secondary mt-3 mb-0">Aucune dépense trouvée</p>
				<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-sm btn-outline-danger mt-3">
					{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}
					Ajouter une dépense
				</a>
			</div>
		{% endif %}
	</div>
</div>
