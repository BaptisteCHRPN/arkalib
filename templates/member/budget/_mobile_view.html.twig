{% macro budgetLineCard(line, organization, budget, indentClass) %}
	<div class="border-bottom bg-white {{ indentClass }}">
		<div class="d-flex justify-content-between align-items-start p-3">
			<div class="flex-grow-1 me-2">
				<div class="d-flex align-items-center mb-1">
					<h4 class="h6 fw-medium mb-0 me-2">{{ line.name }}</h4>
					{% if not line.isActive %}
						<span class="badge bg-secondary" title="Ligne inactive">
							{{ ux_icon('mdi:pause-circle') }}
						</span>
					{% endif %}
				</div>
				{% if line.description %}
					<p class="text-secondary small mb-0">{{ line.description }}</p>
				{% endif %}
			</div>
			<div class="text-end">
				{% if line.expense %}
					<span class="fw-bold text-danger d-block text-nowrap">-
						{{ line.amount|number_format(2, ',', ' ') }}
						€</span>
				{% else %}
					<span class="fw-bold text-success d-block text-nowrap">+
						{{ line.amount|number_format(2, ',', ' ') }}
						€</span>
				{% endif %}
				<div class="dropdown">
					<button class="btn btn-sm btn-light mt-1" type="button" id="dropdownLine{{ line.id }}" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
						{{ ux_icon('mdi:dots-vertical') }}
					</button>
					<ul class="dropdown-menu dropdown-menu-end shadow dropdown-budget">
						<li>
							<a class="dropdown-item" href="{{ path('app_budget_line_show', { 'organizationSlug': organization.slug, 'budgetSlug': budget.slug, 'id': line.id }) }}">
								{{ ux_icon('mdi:eye', {'class': 'me-2'}) }}Voir
							</a>
						</li>
						<li>
							<a class="dropdown-item" href="{{ path('app_member_budget_line_edit', {'id': line.id, 'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}">
								{{ ux_icon('mdi:pencil', {'class': 'me-2'}) }}Modifier
							</a>
						</li>
						<li>
							<a class="dropdown-item" href="{{ path('app_member_transaction_new', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
								{{ ux_icon('hugeicons:transaction', {'class': 'me-2'}) }}Ajouter une transaction
							</a>
						</li>
						<li><hr class="dropdown-divider"></li>
						<li>
							{% include "member/budget_line/_delete_form.html.twig" with {'budgetLine': line} %}
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
{% endmacro %}
{% import _self as macros %}

<div
	class="budget-view-mobile">
	{# Header compact #}
	<div class="px-3 pt-3 pb-2">
		<p class="text-secondary small mb-1">{{ organization.name|title }}</p>
		<h1 class="h5 fw-bold text-primary mb-1">{{ budget.name|title }}</h1>
		<p class="text-secondary small mb-0">
			{{ ux_icon('mdi:calendar-range', {'class': 'me-1'}) }}
			Du {{ budget.startDate|date('d/m/Y') }} au {{ budget.endDate|date('d/m/Y') }}
		</p>
	</div>

	{% if budget.isClosed() %}
		<div class="alert alert-warning d-flex align-items-center mx-3 my-2 py-2" role="alert">
			{{ ux_icon('mdi:lock', {'class': 'me-2'}) }}
			<div><strong>Budget clôturé</strong> — Lecture seule.</div>
		</div>
	{% endif %}

	{# Summary #}
	<div class="row g-0 mx-3 mb-3 mt-2 border rounded overflow-hidden">
		<div class="col-4 text-center p-2 border-end">
			<div class="fw-bold text-success small">+{{ sumIncomes|number_format(0, ',', ' ') }} €</div>
			<div class="text-secondary" style="font-size: 0.7rem">Recettes</div>
		</div>
		<div class="col-4 text-center p-2 border-end">
			<div class="fw-bold text-danger small">-{{ sumExpenses|number_format(0, ',', ' ') }} €</div>
			<div class="text-secondary" style="font-size: 0.7rem">Dépenses</div>
		</div>
		<div class="col-4 text-center p-2">
			<div class="fw-bold {% if balanceBudget > 0 %}text-success{% elseif balanceBudget < 0 %}text-danger{% else %}text-secondary{% endif %} small">
				{% if balanceBudget > 0 %}+{% endif %}{{ balanceBudget|number_format(0, ',', ' ') }} €
			</div>
			<div class="text-secondary" style="font-size: 0.7rem">Solde</div>
		</div>
	</div>

	{# CTA buttons #}
	<div class="px-3 mb-4">
		{% if not budget.isClosed() %}
			<button type="button" class="btn btn-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#budgetLineFormModal">
				{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}Nouvelle ligne budgétaire
			</button>
		{% endif %}
		<div class="row g-2">
			{% if not budget.isClosed() %}
				<div class="col-6">
					<a href="{{ path('app_category_new', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" class="btn btn-outline-primary btn-sm w-100 py-2">
						{{ ux_icon('mdi:tag', {'class': 'me-1'}) }}Catégorie
					</a>
				</div>
			{% endif %}
			<div class="col-6">
				<a href="{{ path('app_member_transaction_index', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" class="btn btn-outline-primary btn-sm w-100 py-2">
					{{ ux_icon('hugeicons:transaction', {'class': 'me-1'}) }}Transactions
				</a>
			</div>
			<div class="col-6">
				<a href="{{ path('app_membre_actuel_budget_show', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-outline-primary btn-sm w-100 py-2">
					{{ ux_icon('tabler:arrows-diff', {'class': 'me-1'}) }}Prévu vs Réel
				</a>
			</div>
			<div class="col-6">
				{% if budget.isClosed() %}
					<form method="post" action="{{ path('app_member_budget_reopen', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('reopen' ~ budget.id) }}">
						<button type="submit" class="btn btn-outline-success btn-sm w-100 py-2">
							{{ ux_icon('mdi:lock-open', {'class': 'me-1'}) }}Réouvrir
						</button>
					</form>
				{% else %}
					<form method="post" action="{{ path('app_member_budget_close', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}"
						onsubmit="return confirm('Êtes-vous sûr de vouloir clôturer ce budget ?')">
						<input type="hidden" name="_token" value="{{ csrf_token('close' ~ budget.id) }}">
						<button type="submit" class="btn btn-outline-danger btn-sm w-100 py-2">
							{{ ux_icon('mdi:lock', {'class': 'me-1'}) }}Clôturer
						</button>
					</form>
				{% endif %}
			</div>
		</div>
	</div>

	{# Budget lines grouped by category #}
	<div class="mb-4">
		{% if categoryGroups|length > 0 or uncategorizedLines|length > 0 %}
			{% for group in categoryGroups %}
				<h3 class="h6 fw-bold bg-body-secondary p-3 mb-0 d-flex justify-content-between align-items-center">
					<span>{{ ux_icon('mdi:folder', {'class': 'me-2'}) }}{{ group.category.name }}</span>
					<span class="small">
						{% if group.expenseTotal > 0 %}<span class="text-danger">-{{ group.expenseTotal|number_format(0, ',', ' ') }} €</span>{% endif %}
						{% if group.incomeTotal > 0 %}<span class="text-success ms-1">+{{ group.incomeTotal|number_format(0, ',', ' ') }} €</span>{% endif %}
					</span>
				</h3>

				{% for line in group.lines %}
					{{ macros.budgetLineCard(line, organization, budget, '') }}
				{% endfor %}

				{% for child in group.children %}
					<h4 class="h6 fw-medium bg-light p-2 ps-4 mb-0 d-flex justify-content-between align-items-center text-secondary">
						<span>{{ ux_icon('mdi:folder-outline', {'class': 'me-2'}) }}{{ child.category.name }}</span>
						<span class="small">
							{% if child.expenseTotal > 0 %}<span class="text-danger">-{{ child.expenseTotal|number_format(0, ',', ' ') }} €</span>{% endif %}
							{% if child.incomeTotal > 0 %}<span class="text-success ms-1">+{{ child.incomeTotal|number_format(0, ',', ' ') }} €</span>{% endif %}
						</span>
					</h4>

					{% for line in child.lines %}
						{{ macros.budgetLineCard(line, organization, budget, 'ps-3') }}
					{% endfor %}

					{% if child.expenseTotal == 0 and child.incomeTotal == 0 %}
						<p class="text-secondary fst-italic small bg-white mb-0 p-3 ps-4">Aucune ligne dans cette sous-catégorie</p>
					{% endif %}
				{% endfor %}

				{% if group.expenseTotal == 0 and group.incomeTotal == 0 %}
					<p class="text-secondary fst-italic small bg-white mb-0 p-3">Aucune ligne dans cette catégorie</p>
				{% endif %}
			{% endfor %}

			{% if uncategorizedLines|length > 0 %}
				<h3 class="h6 fw-bold bg-body-secondary p-3 mb-0 d-flex justify-content-between align-items-center">
					<span>{{ ux_icon('mdi:tag-off', {'class': 'me-2'}) }}Non catégorisé</span>
					<span class="small">
						{% if uncategorizedExpenseTotal > 0 %}<span class="text-danger">-{{ uncategorizedExpenseTotal|number_format(0, ',', ' ') }} €</span>{% endif %}
						{% if uncategorizedIncomeTotal > 0 %}<span class="text-success ms-1">+{{ uncategorizedIncomeTotal|number_format(0, ',', ' ') }} €</span>{% endif %}
					</span>
				</h3>

				{% for line in uncategorizedLines %}
					{{ macros.budgetLineCard(line, organization, budget, '') }}
				{% endfor %}
			{% endif %}

			<div class="bg-light p-3 border-top">
				<div class="d-flex justify-content-between align-items-center">
					<span class="fw-bold">Total :</span>
					<span class="fw-bold">
						<span class="text-danger">-{{ sumExpenses|number_format(2, ',', ' ') }} €</span>
						<span class="text-success ms-2">+{{ sumIncomes|number_format(2, ',', ' ') }} €</span>
					</span>
				</div>
			</div>
		{% else %}
			<div class="text-center py-5 bg-white">
				{{ ux_icon('mdi:inbox', {'class': 'text-secondary', 'style': 'font-size: 3rem;'}) }}
				<p class="text-secondary mt-3 mb-0">Aucune catégorie ni ligne budgétaire pour l'instant</p>
				<button type="button" class="btn btn-sm btn-outline-primary mt-3" data-bs-toggle="modal" data-bs-target="#budgetLineFormModal">
					{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}
					Ajouter une ligne budgétaire
				</button>
			</div>
		{% endif %}
	</div>
</div>
