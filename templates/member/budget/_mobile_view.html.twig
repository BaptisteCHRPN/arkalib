<div
	class="budget-view-mobile">
	{# Header compact #}
	<div class="px-3 pt-3 pb-2">
		<p class="text-secondary small mb-1">{{ organization.name|title }}</p>
		<h1 class="h5 fw-bold text-primary mb-1">{{ budget.name|title }}</h1>
		<p class="text-secondary small mb-0">
			{{ ux_icon('mdi:calendar-range', {'class': 'me-1'}) }}
			Du {{ budget.startDate|date('d/m/Y') }} au {{ budget.endDate|date('d/m/Y') }}
		</p>
	</div>

	{% if budget.isClosed() %}
		<div class="alert alert-warning d-flex align-items-center mx-3 my-2 py-2" role="alert">
			{{ ux_icon('mdi:lock', {'class': 'me-2'}) }}
			<div><strong>Budget clôturé</strong> — Lecture seule.</div>
		</div>
	{% endif %}

	{# Summary #}
	<div class="row g-0 mx-3 mb-3 mt-2 border rounded overflow-hidden">
		<div class="col-4 text-center p-2 border-end">
			<div class="fw-bold text-success small">+{{ sumIncomes|number_format(0, ',', ' ') }} €</div>
			<div class="text-secondary" style="font-size: 0.7rem">Recettes</div>
		</div>
		<div class="col-4 text-center p-2 border-end">
			<div class="fw-bold text-danger small">-{{ sumExpenses|number_format(0, ',', ' ') }} €</div>
			<div class="text-secondary" style="font-size: 0.7rem">Dépenses</div>
		</div>
		<div class="col-4 text-center p-2">
			<div class="fw-bold {% if balanceBudget > 0 %}text-success{% elseif balanceBudget < 0 %}text-danger{% else %}text-secondary{% endif %} small">
				{% if balanceBudget > 0 %}+{% endif %}{{ balanceBudget|number_format(0, ',', ' ') }} €
			</div>
			<div class="text-secondary" style="font-size: 0.7rem">Solde</div>
		</div>
	</div>

	{# CTA buttons #}
	<div class="px-3 mb-4">
		{% if not budget.isClosed() %}
			<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-primary w-100 mb-2">
				{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}Nouvelle ligne budgétaire
			</a>
		{% endif %}
		<div class="row g-2">
			{% if not budget.isClosed() %}
				<div class="col-6">
					<a href="{{ path('app_category_new', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" class="btn btn-outline-primary btn-sm w-100 py-2">
						{{ ux_icon('mdi:tag', {'class': 'me-1'}) }}Catégorie
					</a>
				</div>
			{% endif %}
			<div class="col-6">
				<a href="{{ path('app_member_transaction_index', {'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" class="btn btn-outline-primary btn-sm w-100 py-2">
					{{ ux_icon('hugeicons:transaction', {'class': 'me-1'}) }}Transactions
				</a>
			</div>
			<div class="col-6">
				<a href="{{ path('app_membre_actuel_budget_show', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-outline-primary btn-sm w-100 py-2">
					{{ ux_icon('tabler:arrows-diff', {'class': 'me-1'}) }}Prévu vs Réel
				</a>
			</div>
			<div class="col-6">
				{% if budget.isClosed() %}
					<form method="post" action="{{ path('app_member_budget_reopen', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('reopen' ~ budget.id) }}">
						<button type="submit" class="btn btn-outline-success btn-sm w-100 py-2">
							{{ ux_icon('mdi:lock-open', {'class': 'me-1'}) }}Réouvrir
						</button>
					</form>
				{% else %}
					<form method="post" action="{{ path('app_member_budget_close', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}"
						onsubmit="return confirm('Êtes-vous sûr de vouloir clôturer ce budget ?')">
						<input type="hidden" name="_token" value="{{ csrf_token('close' ~ budget.id) }}">
						<button type="submit" class="btn btn-outline-danger btn-sm w-100 py-2">
							{{ ux_icon('mdi:lock', {'class': 'me-1'}) }}Clôturer
						</button>
					</form>
				{% endif %}
			</div>
		</div>
	</div>

	{# Incomes #}
	<div class="mb-4">
		<h3 class="h6 fw-bold text-success bg-success bg-opacity-10 p-3 mb-0">
			Recettes prévisionnelles
			<span class="badge bg-success float-end">{{ incomes|length }}</span>
		</h3>

		{% if incomes|length > 0 %}
			{% for income in incomes %}
				<div class="border-bottom bg-white">
					<div class="d-flex justify-content-between align-items-start p-3">
						<div class="flex-grow-1 me-2">
							<div class="d-flex align-items-center mb-1">
								<h4 class="h6 fw-medium mb-0 me-2">{{ income.name }}</h4>
								{% if not income.isActive %}
									<span class="badge bg-secondary" title="Ligne inactive">
										{{ ux_icon('mdi:pause-circle') }}
									</span>
								{% endif %}
							</div>

							{% if income.category %}
								<div class="mb-1">
									{% if income.category.parentCategory %}
										<span class="badge bg-light text-dark small">
											{{ income.category.parentCategory.name }}
										</span>
										{{ ux_icon('mdi:chevron-right', {'class': 'small text-secondary'}) }}
									{% endif %}
									<span class="badge bg-success bg-opacity-25 text-success small">
										{{ income.category.name }}
									</span>
								</div>
							{% endif %}

						</div>
						<div class="text-end">
							<span class="fw-bold text-success d-block text-nowrap">+
								{{ income.amount|number_format(2, ',', ' ') }}
								€</span>
							<div class="dropdown">
								<button class="btn btn-sm btn-light mt-1" type="button" id="dropdownIncome{{ income.id }}" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
									{{ ux_icon('mdi:dots-vertical') }}
								</button>
								<ul class="dropdown-menu dropdown-menu-end shadow">
									<li>
										<a class="dropdown-item" href="{{ path('app_budget_line_show', { 'organizationSlug': organization.slug, 'budgetSlug': budget.slug, 'id': income.id }) }}">
											{{ ux_icon('mdi:eye', {'class': 'me-2'}) }}Voir
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_budget_line_edit', {'id': income.id, 'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}">
											{{ ux_icon('mdi:pencil', {'class': 'me-2'}) }}Modifier
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_transaction_new', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
											{{ ux_icon('hugeicons:transaction', {'class': 'me-2'}) }}Ajouter une transaction
										</a>
									</li>
									<li><hr class="dropdown-divider"></li>
									<li>
										{% include "member/budget_line/_delete_form.html.twig" with {'budgetLine': income} %}
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}

			<div class="bg-light p-3">
				<div class="d-flex justify-content-between align-items-center">
					<span class="fw-bold">Total des recettes :</span>
					<span class="fw-bold text-success">+
						{{ sumIncomes|number_format(2, ',', ' ') }}
						€</span>
				</div>
			</div>
		{% else %}
			<div class="text-center py-5 bg-white">
				{{ ux_icon('mdi:inbox', {'class': 'text-secondary', 'style': 'font-size: 3rem;'}) }}
				<p class="text-secondary mt-3 mb-0">Aucune recette trouvée</p>
				<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-sm btn-outline-success mt-3">
					{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}
					Ajouter une recette
				</a>
			</div>
		{% endif %}
	</div>

	{# Expenses #}
	<div class="mb-4">
		<h3 class="h6 fw-bold text-danger bg-danger bg-opacity-10 p-3 mb-0">
			Dépenses prévisionnelles
			<span class="badge bg-danger float-end">{{ expenses|length }}</span>
		</h3>

		{% if expenses|length > 0 %}
			{% for expense in expenses %}
				<div class="border-bottom bg-white">
					<div class="d-flex justify-content-between align-items-start p-3">
						<div class="flex-grow-1 me-2">
							<div class="d-flex align-items-center mb-1">
								<h4 class="h6 fw-medium mb-0 me-2">{{ expense.name }}</h4>
								{% if not expense.isActive %}
									<span class="badge bg-secondary" title="Ligne inactive">
										{{ ux_icon('mdi:pause-circle') }}
									</span>
								{% endif %}
							</div>

							{% if expense.category %}
								<div class="mb-1">
									{% if expense.category.parentCategory %}
										<span class="badge bg-light text-dark small">
											{{ expense.category.parentCategory.name }}
										</span>
										{{ ux_icon('mdi:chevron-right', {'class': 'small text-secondary'}) }}
									{% endif %}
									<span class="badge bg-danger bg-opacity-25 text-danger small">
										{{ expense.category.name }}
									</span>
								</div>
							{% endif %}

						</div>
						<div class="text-end">
							<span class="fw-bold text-danger d-block text-nowrap">-
								{{ expense.amount|number_format(2, ',', ' ') }}
								€</span>
							<div class="dropdown">
								<button class="btn btn-sm btn-light mt-1" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
									{{ ux_icon('mdi:dots-vertical') }}
								</button>
								<ul class="dropdown-menu dropdown-menu-end shadow">
									<li>
										<a class="dropdown-item" href="{{ path('app_budget_line_show', { 'organizationSlug': organization.slug, 'budgetSlug': budget.slug, 'id': expense.id }) }}">
											{{ ux_icon('mdi:eye', {'class': 'me-2'}) }}Voir
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_budget_line_edit', {'id': expense.id, 'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}">
											{{ ux_icon('mdi:pencil', {'class': 'me-2'}) }}Modifier
										</a>
									</li>
									<li>
										<a class="dropdown-item" href="{{ path('app_member_transaction_new', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">
											{{ ux_icon('hugeicons:transaction', {'class': 'me-2'}) }}Ajouter une transaction
										</a>
									</li>
									<li><hr class="dropdown-divider"></li>
									<li>
										{% include "member/budget_line/_delete_form.html.twig" with {'budgetLine': expense} %}
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}

			<div class="bg-light p-3">
				<div class="d-flex justify-content-between align-items-center">
					<span class="fw-bold">Total des dépenses :</span>
					<span class="fw-bold text-danger">-
						{{ sumExpenses|number_format(2, ',', ' ') }}
						€</span>
				</div>
			</div>
		{% else %}
			<div class="text-center py-5 bg-white">
				{{ ux_icon('mdi:inbox', {'class': 'text-secondary', 'style': 'font-size: 3rem;'}) }}
				<p class="text-secondary mt-3 mb-0">Aucune dépense trouvée</p>
				<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-sm btn-outline-danger mt-3">
					{{ ux_icon('mdi:plus-circle', {'class': 'me-2'}) }}
					Ajouter une dépense
				</a>
			</div>
		{% endif %}
	</div>
</div>
