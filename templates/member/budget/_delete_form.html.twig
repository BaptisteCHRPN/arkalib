<form method="post" class="d-inline" action="{{ path('app_member_budget_delete', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id) }}">
    <button class="btn btn-sm btn-outline-danger px-3">Suprimer</button>
</form>
