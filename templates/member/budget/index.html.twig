{% extends 'user_base.html.twig' %}

{% block title %}
	{{ organization.name }}
	|
	{{ budget.name }}
{% endblock %}

{% block body %}
	<h1>{{ organization.name }}</h1>
	<h2>
		{{ budget.name|capitalize }}
	</h2>
	<h3>Dépenses</h3>
	<table class="table table-sm">
		<thead>
			<tr>
				<th>Intitulé</th>
				<th>Montant</th>
			</tr>
		</thead>
		<tbody>
			{% for expense in expenses %}
				<tr>
					<td>{{ expense.name }}</td>
					<td>{{ expense.amount|number_format(2, ',', ' ') }} €</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="8">Aucune dépense trouvée</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	<div>Montant total des dépenses : {{ sum_expenses|number_format(2, ',', ' ') }} €</div>


	<h3>Recettes</h3>
	<table class="table table-sm">
		<thead>
			<tr>
				<th>Intitulé</th>
				<th>Montant</th>
			</tr>
		</thead>
		<tbody>
        
			{% for income in incomes %}
				<tr>
					<td>{{ income.name }}</td>
					<td>{{ income.amount|number_format(2, ',', ' ') }} €</td>
                </tr>
		    {% else %}
                <tr>
					<td colspan="8">Aucune recette trouvée</td>
                </tr>
            {% endfor %}
		</tbody>
	</table>
	<a href="{{ path('app_budget_line_new', {'budgetSlug': budget.slug, 'organizationSlug': organization.slug}) }}" class="btn btn-primary">Nouvelle dépense / Recette</a>

{% endblock %}
