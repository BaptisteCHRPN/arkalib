{% extends 'user_base.html.twig' %}

{% block title %}
	{{ organization.name|title }}
	|
	{{ budget.name|capitalize }}
{% endblock %}

{% block stylesheets %}
	<meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}

	<div class="d-none d-md-block">
		{% include "member/budget/_desktop_view.htm.twig" %}
	</div>

	<div class="d-md-none">
		{% include "member/budget/_mobile_view.html.twig" %}
	</div>

	{# Inutile de laisser les modales dans le DOM d'un lecteur : il n'a aucun
	   bouton pour les ouvrir, et leur formulaire serait de toute façon refusé. #}
	{% if not budget.isClosed() and is_granted('ORGANIZATION_CONTRIBUTE', budget.organization) %}
		{% include "member/budget_line/_new_modal.html.twig" %}
		{% include "member/budget_line/_edit_modal.html.twig" %}
	{% endif %}

{% endblock %}
