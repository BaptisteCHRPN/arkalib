<form method="post" action="{{ path('app_member_transaction_delete', {'id': transaction.id, 'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ transaction.id) }}">
    <button class="btn">Delete</button>
</form>
