<form method="post" action="{{ path('app_member_transaction_delete', {'id': transaction.id, 'organizationSlug': budget.organization.slug, 'budgetSlug': budget.slug}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette transaction ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ transaction.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
