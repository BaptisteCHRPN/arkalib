{% set form_options = {attr: {id: form_id|default('budget-line-form'), 'data-turbo-frame': '_top'}} %}
{% if form_action is defined and form_action %}
    {% set form_options = form_options|merge({action: form_action}) %}
{% endif %}
{% if blockedMessage|default(null) %}
    <div class="alert alert-danger" role="alert">
        {{ blockedMessage }}
        <div class="small mt-2">Si vous aviez choisi une pièce jointe, sélectionnez-la à nouveau.</div>
    </div>
{% endif %}
{{ form_start(form, form_options) }}
    {# Motif pour passer outre : seulement quand la protection des recettes bloque #}
    {% if form.force_reason is defined %}
        {% if blockedMessage|default(null) %}
            {{ form_row(form.force_reason) }}
        {% else %}
            {% do form.force_reason.setRendered %}
        {% endif %}
    {% endif %}
    {{ form_widget(form) }}
    {% if not hideSubmitButton|default(false) %}
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
    {% endif %}
{{ form_end(form) }}
