{% extends 'user_base.html.twig' %}

{% block title %}Category index{% endblock %}

{% block body %}
    <h1>Category index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ORGANIZATION_CONTRIBUTE', organization) %}
        <a href="{{ path('app_category_new', {'organizationSlug': organization.slug, 'budgetSlug': budget.slug}) }}">Create new</a>
    {% endif %}
{% endblock %}
