{% extends 'user_base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block nav %}
    {% include "components/_user_nav.html.twig" %}
{% endblock %}

{% block body %}

<div class="container">
    <div class="row justify-content-center">
        {% for organization in organizations %}
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card text-center">
                    <div class="card-body d-flex flex-column align-items-center">
                        <span class="profile-rounded text-light d-inline-flex align-items-center justify-content-center mb-3">
                            {{ organization.name|first|capitalize }}
                        </span>
                        <h5 class="card-title mb-3">{{ organization.name|title }}</h5>
                        <p class="card-text mb-3">{{ organization.description|capitalize }}</p>
                        <a href="{{ path('app_organization_budgets', {'organizationSlug': organization.slug}) }}" class="btn btn-primary">Ouvrir</a>
                    </div>
                </div>
            </div>
        {% else %}
    </div>
</div>


    <p colspan="6">Aucune organisation trouvée.</p>
{% endfor %}
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary my-1" href="{{ path('app_membre_organization_new') }}">Créer une nouvelle organisation</a>
        <a class="btn btn-primary my-1" href="#">Rejoindre une organisation</a>
    </div>
{% endblock %}
