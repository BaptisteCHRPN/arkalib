{% extends 'user_base.html.twig' %}

{% block title %}Budgets{% endblock %}

{% block body %}
<h1 class="hero-budget-title">Budgets de {{ organization.name }}</h1>
    
<div class="container">
    <div class="row justify-content-center">
        {% for budget in budgets %}
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card text-center">
                    <div class="card-body d-flex flex-column align-items-center">
                        <span class="profile-rounded text-light d-inline-flex align-items-center justify-content-center mb-3">
                            {{ budget.name|first|capitalize }}
                        </span>
                        {# <p>{{ budget.start_date }} {{ budget.end_date }}</p> #}
                        <h5 class="card-title mb-3">{{ budget.name|capitalize }}</h5>
                        <a href="{{ path('app_membre_budget_show', {'slug': budget.slug}) }}" class="btn btn-primary">Ouvrir</a>
                    </div>
                </div>
            </div>
        {% else %}
    </div>
</div>

    <p colspan="6">Aucun budget trouvé.</p>
{% endfor %}
    <a class="btn btn-primary" href="{{ path('app_member_budget_new', {'organizationId': organization.id}) }}">Créer un nouveau budget</a>
{% endblock %}
